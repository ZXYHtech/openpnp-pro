    if production_active:
        archived_spatial_keys = [
            "home_baseline_load", "home_baseline", "home_retest",
            "home_probe_load", "home_probe_x_plus", "home_probe_x_minus",
            "home_probe_y_plus", "home_probe_y_minus",
            "home_probe_analyze", "home_candidate_load",
            "home_candidate_measure", "home_candidate_review",
            "home_surface_load", "home_surface_scan", "home_surface_analyze",
            "dual_dry_load", "dual_dry_path", "dual_physical_load",
            "dual_physical_smoke", "dual_home_validate",
            "dual_primary_validate", "dual_review",
            "fresh_start", "fresh_formal_primary", "fresh_formal_home",
            "fresh_uncomp_load", "fresh_uncomp_primary",
            "fresh_uncomp_home", "fresh_analyze", "fresh_fit"]
        for key in archived_spatial_keys:
            self.agent_step_buttons[key].setEnabled(False)
            self.agent_step_buttons[key].setToolTipText(
                u"已归档：生产路线仅使用Primary曲面；Home只执行P1回归检查。")

    rollback_button = self.agent_step_buttons["rollback"]
    if (machine_enabled or machine_homed) and rollback_button.isEnabled():
        rollback_button.setEnabled(False)
        rollback_button.setToolTipText(
            u"回滚前必须禁用机器并使其处于未Home状态。")

    # T1 is analysis-only. It must remain callable even when an older
    # process-local trial has locked the movement-related workflow buttons.
    segmented_analyze_button = self.agent_step_buttons[
        "traditional_segmented_analyze"]
    segmented_analyze_script = agent_script(
        "CoreXY_Agent_Traditional_Segmented_Analyze.py")
    segmented_analyze_button.setEnabled(segmented_analyze_script.isFile())
    segmented_analyze_button.setToolTipText(
        u"只读取同期基线并生成本机候选；不移动机器、不加载补偿、不修改正式配置。"
        if segmented_analyze_script.isFile() else u"T1分析脚本缺失。")


def run_agent_workflow_script(self, script_name):
    path = agent_script(script_name)
    if not path.isFile():
        JOptionPane.showMessageDialog(
            self, u"找不到工作流脚本：{}".format(path.getAbsolutePath()),
            u"CoreXY Agent工作流", JOptionPane.ERROR_MESSAGE)
        return
    self.append_log(u"启动Agent工作流脚本：{}".format(script_name))
    try:
        source = unicode(String(Files.readAllBytes(path.toPath()), "UTF-8"))
        script_code = compile(source, path.getAbsolutePath(), "exec")
        script_namespace = dict(globals())
        exec script_code in script_namespace
    except Exception as error:
        message = u"Agent工作流脚本返回错误：{}".format(error_text(error))
        self.append_log(message)
        JOptionPane.showMessageDialog(
            self, message, u"CoreXY Agent工作流错误",
            JOptionPane.ERROR_MESSAGE)
    finally:
        self.refresh_agent_workflow()
        if hasattr(self, "refresh_external_fixed_artifacts"):
            self.refresh_external_fixed_artifacts()
        self.refresh_status()


CoreXYTuner._build_agent_workflow_panel = _build_agent_workflow_panel
CoreXYTuner.refresh_agent_workflow = refresh_agent_workflow
CoreXYTuner.run_agent_workflow_script = run_agent_workflow_script

_original_refresh_status = CoreXYTuner.refresh_status


def _refresh_status_with_external_corexy(self):
    _original_refresh_status(self)
    try:
        values = parse_agent_status(current_agent_status())
        available = (values.get("installed") == "true" and
                     values.get("configured") == "true")
        mode = values.get("mode", "")
        config_path = values.get("config", "")
        active = read_agent_properties(File(config_path))
        formal = read_agent_properties(agent_artifact("config/corexy.properties"))
        fixed_temporary = (
            available and values.get("enabled") == "true" and
            values.get("dry-run") == "false" and mode == "state-offset" and
            active.getProperty("trial.kind", "") ==
            "legacy-fixed-vector-physical")
        fixed_persistent = (
            available and values.get("enabled") == "true" and
            values.get("dry-run") == "false" and mode == "state-offset" and
            active.getProperty("model.kind", "") ==
            "FRESH_FIXED_VECTOR_V1" and
            active.getProperty("production.persistence", "") ==
            "persistent")
        fixed_profile = (
            formal.getProperty("model.kind", "") == "FRESH_FIXED_VECTOR_V1" and
            formal.getProperty("production.persistence", "") == "persistent")
        fixed_disabled = (
            available and fixed_profile and values.get("enabled") == "false" and
            agent_same_path(config_path, agent_artifact(
                "config/corexy.properties").getCanonicalPath()))
        onboarding_ready = (
            fixed_disabled and formal.getProperty(
                "onboarding.state", "") == "ready-for-calibration" and
            formal.getProperty("production.acceptance", "") ==
            "bootstrap-new-machine")
        home_baseline = (
            available and values.get("enabled") == "false" and
            active.getProperty("trial.kind", "") ==
            "home-reference-baseline")
        if fixed_persistent:
            gain = agent_float(active, "model.gain", 0.0) * 100.0
            external_state = u"固定A/B补偿生效中（补偿比例{:.0f}%）".format(gain)
        elif fixed_temporary:
            gain = agent_float(active, "model.gain", 0.0) * 100.0
            external_state = u"传统固定A/B临时补偿运行中（增益{:.0f}%）".format(gain)
        elif onboarding_ready:
            external_state = u"新机器初始化完成（零补偿，等待首次标定）"
        elif fixed_disabled:
            external_state = u"固定A/B正式补偿已停用（参数仍保留）"
        elif home_baseline:
            external_state = u"未补偿基线模式已加载（仅当前进程）"
        elif available and mode in ["distance-speed-state-offset",
                                    "distance-speed-position-state-offset"]:
            external_state = u"Agent曲面正式配置运行中；传统A/B试用需先执行F1"
        elif available:
            external_state = u"已加载，当前模式={}".format(mode or u"未知")
        else:
            external_state = u"不可用"

        session = read_agent_properties(agent_artifact(
            "sessions/current-session.properties"))
        session_id = session.getProperty("session.id", u"无")
        session_state = session.getProperty("session.state", u"无")
        current_candidate_path, current_candidate = current_fixed_candidate()
        if current_candidate is not None:
            session_state = u"候选已生成，等待选择补偿比例并应用"
        elif fixed_persistent:
            session_id = u"已归档：{}".format(session_id)
            session_state = u"正式配置已应用"
        active_kind = active.getProperty(
            "trial.kind", active.getProperty("model.kind", u"未知"))
        if home_baseline:
            active_kind = u"未补偿基线"
        gain = (0.0 if home_baseline else
                agent_float(active, "model.gain", 0.0) * 100.0)
        persistence = active.getProperty(
            "trial.persistence", active.getProperty(
                "production.persistence", u"未标记"))
        review_path = latest_external_file(
            "diagnostics",
            "latest-legacy-fixed-physical-review.properties",
            "legacy-fixed-physical-review-")
        review = read_agent_properties(review_path)
        validation_path = latest_external_file(
            "diagnostics",
            "latest-legacy-fixed-physical-validation.properties",
            "legacy-fixed-physical-validation-")
        validation = read_agent_properties(validation_path)
        validation_current = (
            fixed_temporary and validation_path.isFile() and
            agent_same_path(validation.getProperty("source-trial", ""),
                            config_path))
        reviewed_validation = read_agent_properties(File(
            review.getProperty("source-physical-validation", "")))
        review_current = (
            validation_current and review_path.isFile() and
            review.getProperty("state", "") in ["passed", "failed"] and
            reviewed_validation.getProperty("created", "") ==
            validation.getProperty("created", ""))
        health = read_agent_properties(agent_artifact(
            "diagnostics/latest-production-health.properties"))
        production_revision = formal.getProperty("production.promoted-at", u"未应用")
        health_current = (health.getProperty("production.promoted-at", "") ==
                          formal.getProperty("production.promoted-at", ""))
        health_result = ((u"进行中" if health.getProperty(
            "state", "") == "running" else health.getProperty(
                "health.result", u"尚未执行"))
                         if health_current else u"当前版本尚未执行")
        health_time = health.getProperty("completed", health.getProperty(
            "created", u"无")) if health_current else u"无"
        review_result = review.getProperty("state", u"尚未复核")
        accepted_review = read_agent_properties(File(
            formal.getProperty("production.source-review", "")))
        if (review_result == "failed" and
                accepted_review.getProperty("created", "") ==
                review.getProperty("created", "") and
                formal.getProperty("production.acceptance", "") ==
                "user-accepted-with-deviation"):
            review_result = u"系统目标未达标；用户有条件接受"
        review_time = review.getProperty("created", u"无")
        displayed_candidate = current_candidate
        if displayed_candidate is None:
            displayed_candidate = read_agent_properties(File(
                formal.getProperty("production.source-candidate", "")))
        candidate_result = displayed_candidate.getProperty(
            "state", u"尚未生成")
        candidate_time = displayed_candidate.getProperty(
            "created", displayed_candidate.getProperty("completed", u"无"))
        pixel = agent_float(health, "health.pixel-size.rounded.mm", 0.0)
        pixel_line = (u"尚无当前版本像素门限"
                      if not health_current or pixel <= 0.0 else
                      u"{:.3f} mm/px；PASS={:.3f} mm；WARNING={:.3f} mm".format(
                           pixel, pixel * 3.0, pixel * 6.0))
        next_action = u"打开检测与诊断页开始或继续标定"
        session_dir = session.getProperty("session.directory", "")
        if fixed_temporary:
            next_action = u"检测到旧版临时配置；请关闭并重新打开OpenPnP"
        elif current_candidate is not None:
            next_action = u"在候选与应用页确认补偿比例和A/B值，然后点击应用补偿"
        elif fixed_persistent and health_current and health.getProperty(
                "state", "") == "running":
            next_action = u"健康检查正在进行；请等待完成，期间不要执行其他运动"
        elif fixed_persistent and health_current:
            if health_result == "PASS":
                next_action = u"健康检查PASS；查看残差或报告，投入运行前重新Enable并Home"
            elif health_result == "WARNING":
                next_action = u"健康检查WARNING；查看报告，处理机械状态后可重新Home复测或停用补偿"
            else:
                next_action = u"健康检查FAIL；建议停用补偿并检查机械状态"
        elif fixed_persistent:
            next_action = (u"可运行健康检查或空载往返检查" if
                           machine.isEnabled() and machine.isHomed() else
                           u"请Enable并重新Home，再运行健康检查或空载往返检查")
        elif onboarding_ready:
            next_action = u"机器已初始化；请在当前状态页点击开始新标定"
        elif fixed_disabled:
            next_action = u"补偿已停用；可修改补偿比例和A/B数值，然后点击应用补偿"
        elif session_dir and not File(
                session_dir, "uncompensated-primary.properties").isFile():
            next_action = u"完成同期未补偿Primary扫描"
        elif current_candidate is None:
            next_action = u"生成固定A+/B+候选"
        elif not latest_external_file(
                "diagnostics",
                "latest-legacy-fixed-physical-review.properties",
                "legacy-fixed-physical-review-").isFile():
            next_action = u"选择25/50/75/100%并完成实机复测"
        lines = [
            u"外置Agent：{}    当前补偿：{}".format(
                u"可用" if available else u"不可用", external_state),
            u"模型：{}    补偿比例：{:.0f}%    持久性：{}".format(
                active_kind, gain, persistence),
            u"机器：Enabled={}    Homed={}    A/B状态={}/{}".format(
                machine.isEnabled(), machine.isHomed(),
                values.get("A-state", "?"), values.get("B-state", "?")),
            u"正式版本：{}    Session：{} / {}".format(
                production_revision, session_id, session_state),
            u"最近候选：{}    时间：{}".format(candidate_result, candidate_time),
            u"最近健康：{}    时间：{}".format(health_result, health_time),
            u"相机门限：{}".format(pixel_line),
            u"流程：开始新标定 → 采集并生成候选 → 选择补偿比例 → 应用补偿（自动Disable） → 重新Enable/Home → 健康检查或空载往返检查",
            u"操作提示：应用或停用都会等待运动静止并自动Disable；切换后必须重新Enable和Home。补偿生效时参数锁定，停用后恢复编辑并重载同期推荐值。",
            u"下一步：{}".format(next_action)
        ]
        self.status_area.setText(u"\n\n".join(lines))
        self.status_area.setCaretPosition(0)
    except Exception as error:
        self.append_log(u"外置CoreXY状态读取失败：{}".format(error_text(error)))


CoreXYTuner.refresh_status = _refresh_status_with_external_corexy

_original_build_tabs = CoreXYTuner._build_tabs


def _build_tabs_with_agent(self):
    self._build_agent_workflow_panel()
    _original_build_tabs(self)
    self.tabs.addTab(u"CoreXY外置补偿", self.agent_workflow_panel)
    if not self.cross_supported:
        for listener in self.cross_apply_button.getActionListeners():
            self.cross_apply_button.removeActionListener(listener)
        self.cross_apply_button.setText(u"转到传统A/B外置试用")
        self.cross_apply_button.setToolTipText(
            u"当前OpenPnP没有内置A/B接口；使用F1-F6运行同一固定向量候选。")
        self.cross_apply_button.addActionListener(
            lambda event: self.tabs.setSelectedComponent(
                self.agent_workflow_panel))
    self.tabs.setSelectedComponent(self.agent_workflow_panel)


CoreXYTuner._build_tabs = _build_tabs_with_agent


agent_original_ui_backend = agent_script(
    "CoreXY_Agent_Original_UI_Backend.pytxt")
if agent_original_ui_backend.isFile():
    backend_source = unicode(String(Files.readAllBytes(
        agent_original_ui_backend.toPath()), "UTF-8"))
    backend_code = compile(
        backend_source, agent_original_ui_backend.getAbsolutePath(), "exec")
    exec backend_code in globals()
