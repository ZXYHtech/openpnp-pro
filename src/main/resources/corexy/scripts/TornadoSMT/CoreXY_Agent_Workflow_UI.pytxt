    elif recommended_gain is None:
        load_trial_reason = u"最新候选分析没有推荐可验证的增益。"
    elif warning_analysis.getProperty("integrity.config-unchanged", "") != "true":
        load_trial_reason = u"候选分析未通过正式配置完整性检查。"
    elif machine_enabled or machine_homed:
