        analysis_reason = u"当前不是已验证的持久正式补偿。"
    elif confirmation.getProperty(
            "confirmation.result", "") != "WARNING_CONFIRMED":
        analysis_reason = u"只有定向复测确认警告后才需要候选分析。"
    elif (confirmation.getProperty("production.promoted-at", "") !=
          formal.getProperty("production.promoted-at", "")):
        analysis_reason = u"定向复测不属于当前正式配置版本。"
    if analysis_reason is not None:
        analysis_button.setEnabled(False)
        analysis_button.setToolTipText(analysis_reason)
    elif analysis_button.isEnabled():
