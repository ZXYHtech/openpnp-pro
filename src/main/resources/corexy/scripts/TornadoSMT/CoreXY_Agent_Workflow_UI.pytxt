        elif not machine_enabled or not machine_homed:
            reason = u"该测试需要机器已启用并完成Home。"
        elif values.get("homing-bypass") != "false" or \
                values.get("A-state") != "0" or values.get("B-state") != "0":
            reason = u"请重新Home，使A/B初始状态都为0。"
