def agent_runtime_directory():
    return File(scripting.getScriptsDirectory(), AGENT_RUNTIME_RELATIVE_PATH)


def agent_artifact(relative_path):
    return File(agent_runtime_directory(), relative_path)


def workflow_artifact_path(key, relative_path):
    path = agent_artifact(relative_path) if relative_path else None
    if path is not None and path.isFile():
        return path
    legacy = {
        "home_probe_x_plus":
            "diagnostics/latest-home-response-probe-x.properties",
        "home_probe_y_minus":
            "diagnostics/latest-home-response-probe-y.properties",
    }.get(key)
    return agent_artifact(legacy) if legacy else path


def agent_script(script_name):
    hidden_name = (script_name[:-3] + ".pytxt"
                   if script_name.endswith(".py") else script_name)
    return File(
        scripting.getScriptsDirectory(), "TornadoSMT/" + hidden_name)


def read_agent_properties(path):
    props = Properties()
    if path is not None and path.isFile():
        stream = FileInputStream(path)
        try:
            props.load(stream)
        finally:
            stream.close()
    return props


def agent_float(props, key, fallback=None):
    try:
        value = props.getProperty(key)
        return float(value) if value is not None else fallback
    except Exception:
        return fallback


def agent_state_label(state):
    labels = {
        "planned-not-measured": u"已规划",
        "completed": u"已完成",
        "analyzed-not-measured": u"已分析",
        "fitted-not-applied": u"已拟合",
        "passed": u"已通过",
        "promoted": u"已正式启用",
        "running": u"进行中",
        "failed-acceptance": u"等待复核",
        "failed-validation": u"验证未通过",
        "warning": u"警告",
        "failed-health": u"健康检查失败",
        "failed": u"失败",
        "cancelled": u"已取消",
    }
    return labels.get(state, state if state else u"状态未知")


def parse_agent_status(text):
    values = {}
    for line in unicode(text).splitlines():
        if "=" in line:
            key, value = line.split("=", 1)
            values[key.strip()] = value.strip()
    return values


def current_agent_status():
    runtime = agent_runtime_directory()
    jar = File(runtime, "lib/openpnp-corexy-agent.jar")
    path = jar.getCanonicalPath()
    if path not in sys.path:
        sys.path.append(path)
    from org.openpnp.corexy.agent import CoreXYScriptBootstrap
    return unicode(CoreXYScriptBootstrap.status())


def workflow_artifact_text(kind, path):
    if kind == "manual":
        return u"按需执行；结果以测试窗口为准"
    if path is None or not path.isFile():
        return u"未开始"
    props = read_agent_properties(path)
    state = props.getProperty("state", "")
    base = agent_state_label(state)
    if kind == "policy":
        target = agent_float(props, "target.radial-tolerance.mm")
        home_x = agent_float(props, "home-reference.x.mm")
        home_y = agent_float(props, "home-reference.y.mm")
        if target is not None:
            if home_x is not None and home_y is not None:
                return u"二维目标 {:.3f} mm；Home ({:.3f}, {:.3f})；仅复测".format(
                    target, home_x, home_y)
            return u"二维目标 {:.3f} mm".format(target)
    elif kind == "plan":
        maximum = agent_float(props, "recommended-virtual-distance.mm")
        if maximum is not None:
            return u"{}；建议范围 {:.1f} mm".format(base, maximum)
    elif kind == "pilot":
        count = props.getProperty("completed-speed-count", "0")
        return u"{}；速度阶段 {}".format(base, count)
    elif kind == "analysis":
        model = props.getProperty("recommended-model", "")
        return u"{}；{}".format(base, model or u"未推荐模型")
    elif kind == "refine":
        count = props.getProperty("completed-stage-count", "0")
        return u"{}；细化阶段 {}".format(base, count)
    elif kind == "surface":
        index = props.getProperty("recommended-candidate.index", "0")
        gain = agent_float(props, "candidate.{}.gain".format(index))
        if gain is not None:
            return u"{}；推荐增益 {:.0f}%".format(base, gain * 100.0)
    elif kind == "heldout":
        gain = agent_float(props, "candidate-gain")
        passed = props.getProperty("validation.passed", "false") == "true"
        return u"{}；{}；增益 {:.0f}%".format(
            base, u"通过" if passed else u"未通过",
            (gain or 0.0) * 100.0)
    elif kind == "trial":
        gain = agent_float(props, "model.gain")
        return u"已生成临时配置；增益 {:.0f}%".format(
            (gain or 0.0) * 100.0)
    elif kind == "physical":
        before = agent_float(props, "baseline.all.rms.mm")
        after = agent_float(props, "physical.all.rms.mm")
        if before and after is not None:
            improvement = (before - after) * 100.0 / before
            return u"{}；总体RMS改善 {:.1f}%".format(base, improvement)
        error_message = props.getProperty("error.message", "").strip()
        if error_message:
            return u"{}；{}".format(base, error_message)
    elif kind == "legacy-fixed-trial":
        gain = agent_float(props, "model.gain")
        return u"固定向量临时配置；增益 {:.0f}%".format(
            (gain or 0.0) * 100.0)
    elif kind == "review":
        passed = props.getProperty("validation.passed", "false") == "true"
        gain = agent_float(props, "model.gain")
        return u"{}；{}；增益 {:.0f}%".format(
            base, u"可提升" if passed else u"不可提升",
            (gain or 0.0) * 100.0)
    elif kind == "production":
        enabled = props.getProperty("enabled", "false") == "true"
        persistent = props.getProperty("production.persistence", "") == "persistent"
        gain = agent_float(props, "model.gain")
        if enabled and persistent and gain is not None:
            return u"正式启用；持久；增益 {:.0f}%".format(gain * 100.0)
        return u"尚未启用已验证曲面"
    elif kind == "health":
        result = props.getProperty("health.result", "")
        reference_rms = agent_float(props, "reference.all.rms.mm")
        current_rms = agent_float(props, "current.all.rms.mm")
        if reference_rms is not None and current_rms is not None:
            change = (0.0 if reference_rms <= 0.0 else
                      (current_rms - reference_rms) * 100.0 / reference_rms)
            labels = {
                "PASS": u"通过",
                "WARNING": u"警告",
                "FAIL": u"失败",
            }
            return u"{}；RMS {:.6f} -> {:.6f} mm（{:+.1f}%）".format(
                labels.get(result, result or base), reference_rms,
                current_rms, change)
    elif kind == "profile-compare":
        recommendation = props.getProperty("recommendation", "")
        same_baseline = props.getProperty(
            "comparison.same-baseline", "false") == "true"
        labels = {"SURFACE": u"Agent曲面", "LEGACY_FIXED": u"固定向量"}
        return u"{}；建议 {}；基线{}".format(
            base, labels.get(recommendation, recommendation or u"未知"),
            u"一致" if same_baseline else u"不一致")
        return base
    elif kind == "home-baseline-mode":
        if (props.getProperty("trial.kind", "") ==
                "home-reference-baseline"):
            return u"已生成进程内未补偿模式；等待Home后测量"
    elif kind == "home-baseline":
        residual = agent_float(props, "result.radial-residual.mm")
        if residual is not None:
            comparison = agent_float(props, "comparison.compensated-residual.mm")
            if comparison is not None:
                return u"已测；未补偿 {:.6f}，正式补偿 {:.6f} mm".format(
                    residual, comparison)
            return u"已测；B二维未补偿基线 {:.6f} mm".format(residual)
    elif kind == "home-response-probe-mode":
        label = props.getProperty("trial.probe-label", "")
        label = label.replace("-plus", "+").replace("-minus", "-").upper()
        offset_x = agent_float(props, "trial.probe-offset.x.mm")
        offset_y = agent_float(props, "trial.probe-offset.y.mm")
        if label and offset_x is not None and offset_y is not None:
            return u"进程内B-{}探针；偏置 ({:+.3f}, {:+.3f}) mm".format(
                label, offset_x, offset_y)
    elif kind == "home-response-probe":
        label = props.getProperty("probe.label", "")
        if not label:
            axis = props.getProperty("probe.axis", "").lower()
            component = agent_float(props, "probe.offset." + axis + ".mm")
            if axis and component is not None:
                label = axis + ("-plus" if component > 0.0 else "-minus")
        label = label.replace("-plus", "+").replace("-minus", "-").upper()
        response_x = agent_float(props, "probe.response.x-per-mm")
        response_y = agent_float(props, "probe.response.y-per-mm")
        if label and response_x is not None and response_y is not None:
            return u"已测B-{}；响应列 ({:+.3f}, {:+.3f}) mm/mm".format(
                label, response_x, response_y)
    elif kind == "home-response-analysis":
        quality = props.getProperty("identification.quality", "")
        feasible = props.getProperty("solution.target-feasible", "false")
        predicted = agent_float(props, "solution.predicted-residual.mm")
        if predicted is not None:
            return u"已分析；质量{}；目标{}；预测残差 {:.6f} mm".format(
                quality or u"未知",
                u"可达" if feasible == "true" else u"不可达",
                predicted)
    elif kind == "home-response-candidate-mode":
        percent = props.getProperty("trial.candidate-percent", "")
        offset_x = agent_float(props, "trial.candidate-offset.x.mm")
        offset_y = agent_float(props, "trial.candidate-offset.y.mm")
        if percent and offset_x is not None and offset_y is not None:
            return u"进程内{}%候选；B+偏置 ({:+.4f}, {:+.4f}) mm".format(
                percent, offset_x, offset_y)
    elif kind == "home-response-candidate":
        percent = props.getProperty("candidate.percent", "")
        residual = agent_float(props, "result.radial-residual.mm")
        improvement = agent_float(props, "comparison.improvement.percent")
        if percent and residual is not None:
            return u"已测{}%；残差 {:.6f} mm；改善 {:+.1f}%".format(
                percent, residual, improvement or 0.0)
    elif kind == "home-response-candidate-review":
        percent = props.getProperty("review.recommended-percent", "")
        residual = agent_float(props, "review.recommended-residual.mm")
        if percent and residual is not None:
            return u"已复核；实测较优{}%；残差 {:.6f} mm；未应用".format(
                percent, residual)
    elif kind == "home-b-surface-scan":
        cells = props.getProperty("cell.count", "")
        speeds = props.getProperty("grid.speed.count", "")
        distances = props.getProperty("grid.distance.count", "")
        if cells:
            return u"已扫描；{}速度 x {}距离，共{}单元；未补偿".format(
                speeds or u"?", distances or u"?", cells)
    elif kind == "dual-reference-home-b":
        raw = agent_float(props, "summary.raw.rms.mm")
        formal_predicted = agent_float(
            props, "summary.formal-predicted.rms.mm")
        local = agent_float(
            props, "summary.home-candidate-predicted.rms.mm")
        if raw is not None and formal_predicted is not None and local is not None:
            return u"诊断候选；RMS 原始 {:.4f} / 正式预测 {:.4f} / Home局部 {:.4f} mm".format(
                raw, formal_predicted, local)
    elif kind == "dual-reference-trial":
        trial_kind = props.getProperty("trial.kind", "")
        if trial_kind == "dual-reference-home-b-dry-run":
            return u"已生成进程内双参考点干运行配置；未实补偿"
        if trial_kind == "dual-reference-home-b-physical":
            return u"已生成进程内双参考点实补偿配置；未写入正式配置"
    elif kind == "dual-home-validation":
        before = agent_float(props, "baseline.rms.mm")
        after = agent_float(props, "physical.rms.mm")
        passed = props.getProperty("validation.passed", "false") == "true"
        if before and after is not None:
            improvement = 100.0 * (before - after) / before
            return u"{}；Home RMS {:.6f} -> {:.6f} mm（改善 {:+.1f}%）".format(
                u"通过" if passed else u"未通过", before, after, improvement)
    elif kind == "dual-primary-validation":
        before = agent_float(props, "baseline.all.rms.mm")
        after = agent_float(props, "physical.all.rms.mm")
        passed = props.getProperty("validation.passed", "false") == "true"
        if before and after is not None:
            change = 100.0 * (after - before) / before
            return u"{}；Primary RMS {:.6f} -> {:.6f} mm（变化 {:+.1f}%）".format(
                u"通过" if passed else u"未通过", before, after, change)
    elif kind == "dual-reference-review":
        passed = props.getProperty("review.passed", "false") == "true"
        return (u"双锚点均通过；等待受控提升设计" if passed else
                u"双锚点未全部通过；禁止提升")
    elif kind == "home-retest":
        result = props.getProperty("result.classification", "")
        residual = agent_float(props, "result.radial-residual.mm")
        target = agent_float(props, "target.radial-tolerance.mm")
        labels = {
            "PASS_ROBUST": u"稳健通过",
            "PASS_MARGINAL": u"临界通过",
            "FAIL_TARGET": u"超过目标",
            "FAIL_INTEGRITY": u"配置完整性失败",
        }
        if residual is not None and target is not None:
            baseline = agent_float(props, "comparison.baseline-residual.mm")
            if baseline is not None:
                improvement = agent_float(props, "comparison.improvement.percent", 0.0)
                return u"{}；未补偿 {:.6f} -> 补偿 {:.6f} mm（{:+.1f}%）".format(
                    labels.get(result, result or base), baseline, residual,
                    improvement)
            return u"{}；B二维残差 {:.6f} / 目标 {:.3f} mm".format(
                labels.get(result, result or base), residual, target)
        return labels.get(result, base)
    elif kind == "health-confirm":
        result = props.getProperty("confirmation.result", "")
        labels = {
            "PASS_CLEARED": u"复测通过，警告已解除",
            "WARNING_CONFIRMED": u"警告已复现",
            "WARNING_UNCONFIRMED": u"警告未稳定复现",
            "FAIL": u"复测失败",
        }
        current = agent_float(props, "target.magnitude.mm")
        reference = agent_float(props, "warning.reference.magnitude.mm")
        if current is not None and reference is not None:
            return u"{}；{:.6f} -> {:.6f} mm".format(
                labels.get(result, result or base), reference, current)
        return labels.get(result, base)
    elif kind == "warning-analysis":
        gain = agent_float(props, "recommended-gain")
        unchanged = props.getProperty("integrity.config-unchanged", "false")
        if gain is not None:
            return u"已分析；推荐临时验证 {:.0f}%；配置未变 {}".format(
                gain * 100.0, unchanged)
        return u"已分析；无候选通过全部保护条件"
    elif kind == "warning-trial":
        gain = agent_float(props, "trial.target-gain")
        return u"已生成进程内临时配置；增益 {:.0f}%".format(
            (gain or 0.0) * 100.0)
    elif kind == "warning-trial-validation":
        result = props.getProperty("validation.result", "")
        measured = agent_float(props, "target.magnitude.mm")
        labels = {
            "PASS_ROBUST": u"稳健通过",
            "PASS": u"通过",
            "INCONCLUSIVE": u"结果不明确",
            "FAIL": u"未通过",
        }
        if measured is not None:
            return u"{}；目标残差 {:.6f} mm".format(
                labels.get(result, result or base), measured)
        return labels.get(result, base)
    elif kind == "restore-formal":
        gain = agent_float(props, "model.gain")
        return u"可恢复当前正式配置；增益 {:.0f}%".format(
            (gain or 0.0) * 100.0)
    elif kind == "rollback":
        return u"回滚点可用"
    return base


def agent_summary_text(status, formal, review):
    values = parse_agent_status(status)
    if values.get("installed") != "true" or values.get("configured") != "true":
        return u"Agent未正确安装或配置"
    active = read_agent_properties(File(values.get("config", "")))
    if (values.get("enabled") == "true" and
            values.get("dry-run") == "false" and
            values.get("mode") == "state-offset" and
            active.getProperty("model.kind", "") ==
            "FRESH_FIXED_VECTOR_V1" and
            active.getProperty("production.persistence", "") ==
            "persistent"):
        gain = agent_float(active, "model.gain", 0.0)
        return u"正式CoreXY固定A/B补偿运行中，增益 {:.0f}%".format(
            gain * 100.0)
    if (values.get("enabled") == "false" and
            values.get("dry-run") == "false" and
            active.getProperty("trial.kind", "") ==
            "home-reference-baseline" and
            active.getProperty("trial.persistence", "") == "process-only"):
        return u"Home未补偿基线模式运行中；禁止生产，测量后恢复正式配置"
    if (values.get("enabled") == "true" and
            values.get("mode") ==
            "distance-speed-position-state-offset"):
        kind = active.getProperty("trial.kind", "")
        if values.get("dry-run") == "true" and kind == \
                "dual-reference-home-b-dry-run":
            return u"双参考点B曲面干运行中；无物理补偿，禁止生产"
        if values.get("dry-run") == "false" and kind == \
                "dual-reference-home-b-physical":
            return u"双参考点B曲面临时实补偿运行中；禁止生产，重启即恢复正式配置"
    if (values.get("enabled") == "true" and
            values.get("dry-run") == "false" and
            values.get("mode") == "state-offset" and
            active.getProperty("trial.kind", "") ==
            "legacy-fixed-vector-physical" and
            active.getProperty("trial.persistence", "") == "process-only"):
        gain = agent_float(active, "model.gain", 0.0)
        return u"旧固定向量 {:.0f}% 临时实补偿运行中；禁止生产，完成验收后恢复正式曲面".format(
            gain * 100.0)
    if (values.get("enabled") == "true" and
            values.get("dry-run") == "false" and
            values.get("mode") == "state-offset" and
            active.getProperty("trial.kind", "") == "home-response-probe" and
            active.getProperty("trial.persistence", "") == "process-only"):
        label = active.getProperty("trial.probe-label", "")
        label = label.replace("-plus", "+").replace("-minus", "-").upper()
        return u"Home B-{}二维响应探针运行中；禁止生产，测量后恢复正式配置".format(
            label or u"?")
    if (values.get("enabled") == "true" and
            values.get("dry-run") == "false" and
            values.get("mode") == "state-offset" and
            active.getProperty("trial.kind", "") ==
            "home-response-candidate" and
            active.getProperty("trial.persistence", "") == "process-only"):
        percent = active.getProperty("trial.candidate-percent", "?")
        return u"Home二维响应{}%候选运行中；禁止生产，实测后恢复正式配置".format(
            percent)
    if (values.get("enabled") == "true" and
            values.get("dry-run") == "false" and
            values.get("mode") == "distance-speed-state-offset"):
        gain = agent_float(active, "model.gain")
        if (active.getProperty("trial.kind", "") == "health-warning-gain" and
                active.getProperty("trial.persistence", "") == "process-only"):
            formal_gain = agent_float(formal, "model.gain", 0.0)
            return u"警告候选临时实补偿运行中，增益 {:.0f}%；重启或恢复正式配置即回到{:.0f}%".format(
                (gain or 0.0) * 100.0, formal_gain * 100.0)
        if formal.getProperty("production.persistence", "") == "persistent":
            return u"正式CoreXY曲面补偿运行中，增益 {:.0f}%".format(
                (gain or 0.0) * 100.0)
        return u"临时CoreXY实补偿运行中，增益 {:.0f}%".format(
            (gain or 0.0) * 100.0)
    if review.getProperty("validation.passed", "false") == "true":
        return u"物理验收已通过，等待正式启用"
    return u"CoreXY自动校准尚未完成"


def agent_same_path(left, right):
    try:
        return File(unicode(left)).getCanonicalPath().lower() == \
            File(unicode(right)).getCanonicalPath().lower()
    except Exception:
        return False


def agent_grid_constraints(x, y, width=1, weightx=0.0,
                           fill=GridBagConstraints.NONE):
    constraints = GridBagConstraints()
    constraints.gridx = x
    constraints.gridy = y
    constraints.gridwidth = width
    constraints.weightx = weightx
    constraints.fill = fill
    constraints.anchor = GridBagConstraints.WEST
    constraints.insets = Insets(2, 5, 2, 5)
    return constraints


def _build_agent_workflow_panel(self):
    root = JPanel(BorderLayout(8, 8))
    root.setBorder(BorderFactory.createEmptyBorder(8, 8, 8, 8))

    header = JPanel(BorderLayout(6, 6))
    self.agent_summary_label = JLabel(u"正在读取Agent状态...")
    self.agent_summary_label.setFont(
        self.agent_summary_label.getFont().deriveFont(Font.BOLD, 14.0))
    self.agent_status_area = JTextArea(6, 72)
    self.agent_status_area.setEditable(False)
    self.agent_status_area.setFont(Font("Monospaced", Font.PLAIN, 12))
    refresh = JButton(u"刷新工作流状态")
    refresh.addActionListener(lambda event: self.refresh_agent_workflow())
    header.add(self.agent_summary_label, BorderLayout.NORTH)
    header.add(JScrollPane(self.agent_status_area), BorderLayout.CENTER)
    header.add(refresh, BorderLayout.SOUTH)
    root.add(header, BorderLayout.NORTH)

    grid = JPanel(GridBagLayout())
    grid.setBorder(BorderFactory.createTitledBorder(
        u"CoreXY外置补偿（F1-F6：传统固定A/B；0-12：曲面校准）"))
    grid.add(JLabel(u"阶段"), agent_grid_constraints(0, 0))
    grid.add(JLabel(u"当前结果"), agent_grid_constraints(
        1, 0, 1, 1.0, GridBagConstraints.HORIZONTAL))
    grid.add(JLabel(u"操作"), agent_grid_constraints(2, 0))
    self.agent_step_status = {}
    self.agent_step_buttons = {}
    for row, step in enumerate(AGENT_WORKFLOW_STEPS, 1):
        key, title, script_name, relative_path, kind, button_text = step
        title_label = JLabel(title)
        status_label = JLabel(u"未读取")
        button = JButton(button_text)
        button.setPreferredSize(Dimension(118, 24))
        button.addActionListener(
            lambda event, name=script_name: self.run_agent_workflow_script(name))
        grid.add(title_label, agent_grid_constraints(0, row))
        grid.add(status_label, agent_grid_constraints(
            1, row, 1, 1.0, GridBagConstraints.HORIZONTAL))
        grid.add(button, agent_grid_constraints(2, row))
        self.agent_step_status[key] = status_label
        self.agent_step_buttons[key] = button

    scroll = JScrollPane(grid)
    scroll.getVerticalScrollBar().setUnitIncrement(18)
    root.add(scroll, BorderLayout.CENTER)
    safety = JLabel(
        u"带运动的步骤仍会独立确认、检查Home和XY软限位；正式提升与回滚只允许在机器禁用且未Home时执行。")
    root.add(safety, BorderLayout.SOUTH)
    self.agent_workflow_panel = root
    self.refresh_agent_workflow()


def refresh_agent_workflow(self):
    try:
        status = current_agent_status()
    except Exception as error:
        status = u"installed=false\nerror={}".format(error_text(error))
    formal_path = agent_artifact("config/corexy.properties")
    review_path = agent_artifact(
        "diagnostics/latest-auto-calibration-physical-review.properties")
    health_path = agent_artifact(
        "diagnostics/latest-production-health.properties")
    confirmation_path = agent_artifact(
        "diagnostics/latest-production-health-confirmation.properties")
    warning_analysis_path = agent_artifact(
        "diagnostics/latest-health-warning-candidate-analysis.properties")
    policy_path = agent_artifact("config/calibration-policy.properties")
    home_baseline_path = agent_artifact(
        "diagnostics/latest-home-reference-baseline.properties")
    home_retest_path = agent_artifact(
        "diagnostics/latest-home-reference-retest.properties")
    formal = read_agent_properties(formal_path)
    review = read_agent_properties(review_path)
    health = read_agent_properties(health_path)
    confirmation = read_agent_properties(confirmation_path)
    warning_analysis = read_agent_properties(warning_analysis_path)
    policy = read_agent_properties(policy_path)
    home_baseline = read_agent_properties(home_baseline_path)
    home_retest = read_agent_properties(home_retest_path)
    summary = agent_summary_text(status, formal, review)
    health_result = health.getProperty("health.result", "")
    if (health_result and
            health.getProperty("production.promoted-at", "") ==
            formal.getProperty("production.promoted-at", "")):
        health_labels = {
            "PASS": u"通过", "WARNING": u"警告", "FAIL": u"失败"}
        summary += u"；最近健康检查：{}".format(
            health_labels.get(health_result, health_result))
    confirmation_result = confirmation.getProperty("confirmation.result", "")
    if (confirmation_result and
            confirmation.getProperty("production.promoted-at", "") ==
            formal.getProperty("production.promoted-at", "")):
        confirmation_labels = {
            "PASS_CLEARED": u"警告已解除",
            "WARNING_CONFIRMED": u"警告已复现",
            "WARNING_UNCONFIRMED": u"警告未稳定复现",
            "FAIL": u"复测失败",
        }
        summary += u"；定向复测：{}".format(
            confirmation_labels.get(confirmation_result, confirmation_result))
    self.agent_summary_label.setText(summary)

    values = parse_agent_status(status)
    active_offset = values.get("active-offset", "unknown")
    if active_offset == "()":
        active_offset = "(X=0.000000, Y=0.000000)"
    lines = [
        u"Agent安装/配置：{}/{}".format(
            values.get("installed", "false"),
            values.get("configured", "false")),
        u"补偿模式：{}；启用/干运行：{}/{}".format(
            values.get("mode", "unknown"),
            values.get("enabled", "unknown"),
            values.get("dry-run", "unknown")),
        u"正式配置：{}".format(values.get("config", "unknown")),
        u"机器已启用/已Home：{}/{}".format(
            u"是" if machine.isEnabled() else u"否",
            u"是" if machine.isHomed() else u"否"),
        u"A/B状态：{}/{}；当前位置偏置：{}".format(
            values.get("A-state", "unknown"),
            values.get("B-state", "unknown"), active_offset),
    ]
    before = agent_float(review, "baseline.all.rms.mm")
    after = agent_float(review, "physical.all.rms.mm")
    if before and after is not None:
        lines.append(u"已验证RMS：{:.6f} -> {:.6f} mm（改善 {:.1f}%）".format(
            before, after, (before - after) * 100.0 / before))
    target = agent_float(policy, "target.radial-tolerance.mm")
    if target is not None:
        lines.append(u"用户二维径向目标：{:.3f} mm；策略：满足目标的最小必要补偿".format(
            target))
    home_residual = agent_float(home_retest, "result.radial-residual.mm")
    home_baseline_residual = agent_float(
        home_baseline, "result.radial-residual.mm")
    comparison_source = None
    if home_retest.getProperty("comparison.available", "false") == "true":
        comparison_source = home_retest
    elif home_baseline.getProperty(
            "comparison.available", "false") == "true":
        comparison_source = home_baseline
    if comparison_source is not None:
        compared_baseline = agent_float(
            comparison_source, "comparison.baseline-residual.mm")
        compared_formal = agent_float(
            comparison_source, "comparison.compensated-residual.mm")
        compared_change = agent_float(
            comparison_source, "comparison.improvement.percent", 0.0)
        lines.append(u"Home同条件对比：未补偿 {:.6f} -> 正式补偿 {:.6f} mm（{:+.1f}%）".format(
            compared_baseline, compared_formal, compared_change))
    else:
        if home_baseline_residual is not None:
            lines.append(u"最近Home未补偿基线：B状态二维差 {:.6f} mm".format(
                home_baseline_residual))
        if home_residual is not None:
            lines.append(u"最近Home复测：B状态二维残差 {:.6f} mm（尚无同条件基线）".format(
                home_residual))
    self.agent_status_area.setText(u"\n".join(lines))
    self.agent_status_area.setCaretPosition(0)

    for step in AGENT_WORKFLOW_STEPS:
        key, title, script_name, relative_path, kind, button_text = step
        path = workflow_artifact_path(key, relative_path)
        self.agent_step_status[key].setText(
            workflow_artifact_text(kind, path))
        script_path = agent_script(script_name)
        self.agent_step_buttons[key].setEnabled(script_path.isFile())
        if not script_path.isFile():
            self.agent_step_status[key].setText(u"脚本缺失")

    physical = read_agent_properties(agent_artifact(
        "diagnostics/latest-auto-calibration-physical-validation.properties"))
    if (physical.getProperty("state", "") == "failed-acceptance" and
            review.getProperty("validation.passed", "false") == "true"):
        physical_before = agent_float(physical, "baseline.all.rms.mm")
        physical_after = agent_float(physical, "physical.all.rms.mm")
        if physical_before and physical_after is not None:
            improvement = ((physical_before - physical_after) * 100.0 /
                           physical_before)
            self.agent_step_status["physical"].setText(
                u"严格门限未通过；视觉复核已通过；RMS改善 {:.1f}%".format(
                    improvement))

    formal_mode = values.get("mode", "")
    fixed_production = (
        formal_mode == "state-offset" and
        formal.getProperty("model.kind", "") == "FRESH_FIXED_VECTOR_V1" and
        formal.getProperty("production.acceptance", "") ==
        "user-accepted-with-deviation")
    surface_production = formal_mode == "distance-speed-state-offset"
    production_active = (
        values.get("enabled") == "true" and
        values.get("dry-run") == "false" and
        (surface_production or fixed_production) and
        formal.getProperty("production.persistence", "") == "persistent" and
        agent_same_path(values.get("config", ""), formal_path))
    active_config = read_agent_properties(File(values.get("config", "")))
    warning_trial_active = (
        values.get("enabled") == "true" and
        values.get("dry-run") == "false" and
        values.get("mode") == "distance-speed-state-offset" and
        active_config.getProperty("trial.kind", "") == "health-warning-gain" and
        active_config.getProperty("trial.persistence", "") == "process-only")
    home_baseline_active = (
        values.get("enabled") == "false" and
        values.get("dry-run") == "false" and
        active_config.getProperty("trial.kind", "") ==
        "home-reference-baseline" and
        active_config.getProperty("trial.persistence", "") == "process-only")
    home_probe_axis = active_config.getProperty("trial.probe-axis", "").lower()
    home_probe_label = active_config.getProperty("trial.probe-label", "").lower()
    home_probe_active = (
        values.get("enabled") == "true" and
        values.get("dry-run") == "false" and
        values.get("mode") == "state-offset" and
        active_config.getProperty("trial.kind", "") == "home-response-probe" and
        active_config.getProperty("trial.persistence", "") == "process-only" and
        home_probe_axis in ["x", "y"] and
        home_probe_label in ["x-plus", "x-minus", "y-plus", "y-minus"])
    home_candidate_percent = active_config.getProperty(
        "trial.candidate-percent", "")
    home_candidate_active = (
        values.get("enabled") == "true" and
        values.get("dry-run") == "false" and
        values.get("mode") == "state-offset" and
        active_config.getProperty("trial.kind", "") ==
        "home-response-candidate" and
        active_config.getProperty("trial.persistence", "") == "process-only" and
        home_candidate_percent in ["50", "75", "100"])
    legacy_fixed_active = (
        values.get("enabled") == "true" and
        values.get("dry-run") == "false" and
        values.get("mode") == "state-offset" and
        active_config.getProperty("trial.kind", "") ==
        "legacy-fixed-vector-physical" and
        active_config.getProperty("trial.persistence", "") == "process-only")
    traditional_segmented_active = (
        values.get("enabled") == "true" and
        values.get("dry-run") == "false" and
        values.get("mode") == "distance-speed-state-offset" and
        active_config.getProperty("trial.kind", "") ==
        "traditional-segmented-physical" and
        active_config.getProperty("trial.persistence", "") == "process-only")
    dual_dry_active = (
        values.get("enabled") == "true" and
        values.get("dry-run") == "true" and
        values.get("mode") == "distance-speed-position-state-offset" and
        active_config.getProperty("trial.kind", "") ==
        "dual-reference-home-b-dry-run" and
        active_config.getProperty("trial.persistence", "") == "process-only")
    dual_physical_active = (
        values.get("enabled") == "true" and
        values.get("dry-run") == "false" and
        values.get("mode") == "distance-speed-position-state-offset" and
        active_config.getProperty("trial.kind", "") ==
        "dual-reference-home-b-physical" and
        active_config.getProperty("trial.persistence", "") == "process-only")
    machine_enabled = machine.isEnabled()
    machine_homed = machine.isHomed()
    if not traditional_segmented_active and not machine_enabled:
        self.agent_summary_label.setText(
            u"传统分段A/B路线就绪：下一步点击T1生成本机候选")
    elif traditional_segmented_active and (not machine_enabled or not machine_homed):
        self.agent_summary_label.setText(
            u"传统分段A/B已加载：下一步启用机器并执行正常Home")
    elif traditional_segmented_active:
        self.agent_summary_label.setText(
            u"传统分段A/B验收就绪：下一步点击T3")
    elif legacy_fixed_active and (not machine_enabled or not machine_homed):
        self.agent_summary_label.setText(
            u"传统A/B固定向量已加载：下一步启用机器并执行正常Home")
    elif legacy_fixed_active:
        self.agent_summary_label.setText(
            u"传统A/B验收就绪：下一步点击F3（F2已通过可不重复）")

    segmented_candidate = agent_artifact(
        "candidates/latest-traditional-segmented.properties")
    segmented_physical = agent_artifact(
        "diagnostics/latest-traditional-segmented-physical-validation.properties")
    segmented_reasons = {}
    traditional_start_reason = None
    if not production_active:
        traditional_start_reason = u"请先重启OpenPnP以恢复持久正式配置。"
    elif machine_enabled or machine_homed:
        traditional_start_reason = u"新建同期基线前必须禁用机器并处于未Home状态。"
    if traditional_start_reason is not None:
        self.agent_step_buttons["traditional_fresh_start"].setEnabled(False)
        self.agent_step_buttons["traditional_fresh_start"].setToolTipText(
            traditional_start_reason)

    traditional_scan_reason = None
    if not home_baseline_active:
        traditional_scan_reason = u"请先执行T0-1加载同期未补偿模式。"
    elif not machine_enabled or not machine_homed:
        traditional_scan_reason = u"请启用机器并完成正常Home。"
    elif values.get("homing-bypass") != "false":
        traditional_scan_reason = u"Home过程尚未完全结束。"
    if traditional_scan_reason is not None:
        self.agent_step_buttons["traditional_fresh_scan"].setEnabled(False)
        self.agent_step_buttons["traditional_fresh_scan"].setToolTipText(
            traditional_scan_reason)

    fresh_fixed_baseline = None
    fresh_fixed_session = agent_artifact(
        "sessions/current-session.properties")
    if fresh_fixed_session.isFile():
        current_session_props = read_agent_properties(fresh_fixed_session)
        session_directory = current_session_props.getProperty(
            "session.directory", "")
        if session_directory:
            fresh_fixed_baseline = File(
                session_directory, "uncompensated-primary.properties")
    if (fresh_fixed_baseline is None or
            not fresh_fixed_baseline.isFile()):
        self.agent_step_buttons["fresh_fixed_analyze"].setEnabled(False)
        self.agent_step_buttons["fresh_fixed_analyze"].setToolTipText(
            u"请先完成T0-1和T0-2，采集本次同期未补偿Primary基线。")

    if machine_enabled or machine_homed:
        segmented_reasons["traditional_segmented_load"] = \
            u"加载临时实补偿前必须禁用机器并处于未Home状态。"
    if not segmented_candidate.isFile():
        segmented_reasons["traditional_segmented_load"] = \
            u"请先点击T1生成本机分段候选。"
    if not traditional_segmented_active:
        segmented_reasons["traditional_segmented_validate"] = \
            u"请先点击T2加载传统分段临时实补偿。"
    elif not machine_enabled or not machine_homed:
        segmented_reasons["traditional_segmented_validate"] = \
            u"请先启用机器并完成正常Home。"
    if not segmented_physical.isFile():
        segmented_reasons["traditional_segmented_review"] = \
            u"请先完成T3传统分段视觉验收。"
    for key in ["traditional_segmented_analyze",
                "traditional_segmented_load",
                "traditional_segmented_validate",
                "traditional_segmented_review"]:
        if key in segmented_reasons:
            self.agent_step_buttons[key].setEnabled(False)
            self.agent_step_buttons[key].setToolTipText(segmented_reasons[key])

    calibration_keys = [
        "plan", "pilot", "analyze", "refine", "surface", "heldout",
        "load25", "smoke", "physical", "review", "promote"]
    for key in calibration_keys:
        button = self.agent_step_buttons[key]
        if production_active and button.isEnabled():
            button.setEnabled(False)
            button.setToolTipText(
                u"正式补偿正在运行；该阶段属于新一轮未补偿校准。")

    if warning_trial_active:
        for key in self.agent_step_buttons:
            if key not in ["warning_trial_smoke", "warning_trial_validate",
                           "restore_formal"]:
                self.agent_step_buttons[key].setEnabled(False)
                self.agent_step_buttons[key].setToolTipText(
                    u"推荐候选临时实补偿正在运行；只能冒烟、实测候选或恢复正式配置。")

    if home_baseline_active:
        for key in self.agent_step_buttons:
            if key not in ["home_baseline", "home_restore",
                           "home_surface_scan", "home_surface_analyze",
                           "home_surface_restore", "fresh_uncomp_primary",
                           "fresh_uncomp_home", "fresh_analyze",
                           "fresh_fit", "fresh_restore",
                           "traditional_fresh_scan",
                           "traditional_segmented_analyze",
                           "fresh_fixed_analyze",
                           "legacy_fixed_load"]:
                self.agent_step_buttons[key].setEnabled(False)
                self.agent_step_buttons[key].setToolTipText(
                    u"Home未补偿基线模式正在运行；只能测量基线或恢复正式配置。")

    if home_probe_active:
        for key in self.agent_step_buttons:
            if key not in ["home_probe_load", "home_probe_x_plus",
                           "home_probe_x_minus", "home_probe_y_plus",
                           "home_probe_y_minus",
                           "home_probe_analyze", "home_candidate_load",
                           "home_probe_restore"]:
                self.agent_step_buttons[key].setEnabled(False)
                self.agent_step_buttons[key].setToolTipText(
                    u"Home二维响应探针正在运行；只能测量、切换探针、分析或恢复正式配置。")

    if home_candidate_active:
        for key in self.agent_step_buttons:
            if key not in ["home_candidate_load", "home_candidate_measure",
                           "home_candidate_review", "home_probe_restore"]:
                self.agent_step_buttons[key].setEnabled(False)
                self.agent_step_buttons[key].setToolTipText(
                    u"Home响应候选正在运行；只能实测、切换候选、复核或恢复正式配置。")

    if traditional_segmented_active:
        for key in self.agent_step_buttons:
            if key not in ["traditional_segmented_validate",
                           "traditional_segmented_review",
                           "legacy_fixed_restore"]:
                self.agent_step_buttons[key].setEnabled(False)
                self.agent_step_buttons[key].setToolTipText(
                    u"传统分段A/B临时实补偿正在运行；只能验收、复核或恢复正式配置。")

    if dual_dry_active:
        for key in self.agent_step_buttons:
            if key not in ["dual_dry_path", "dual_physical_load",
                           "dual_restore"]:
                self.agent_step_buttons[key].setEnabled(False)
                self.agent_step_buttons[key].setToolTipText(
                    u"双参考点干运行配置正在运行；只能检查路径、加载临时实补偿或恢复正式配置。")

    if dual_physical_active:
        for key in self.agent_step_buttons:
            if key not in ["dual_physical_smoke", "dual_home_validate",
                           "dual_primary_validate", "dual_review",
                           "dual_restore"]:
                self.agent_step_buttons[key].setEnabled(False)
                self.agent_step_buttons[key].setToolTipText(
                    u"双参考点临时实补偿正在运行；只能执行冒烟、视觉验收、综合复核或恢复正式配置。")

    if legacy_fixed_active:
        for key in self.agent_step_buttons:
            if key not in ["legacy_fixed_smoke", "legacy_fixed_validate",
                           "legacy_fixed_review", "profile_compare",
                           "legacy_fixed_restore"]:
                self.agent_step_buttons[key].setEnabled(False)
                self.agent_step_buttons[key].setToolTipText(
                    u"固定向量临时实补偿正在运行；只能冒烟、验收、复核、对比或恢复正式曲面。")

    legacy_load_button = self.agent_step_buttons["legacy_fixed_load"]
    legacy_load_reason = None
    fresh_fixed_candidate = agent_artifact(
        "candidates/latest-fresh-fixed-vector.properties")
    fresh_fixed_ready = (home_baseline_active and
                         fresh_fixed_candidate.isFile())
    if not production_active and not fresh_fixed_ready:
        legacy_load_reason = u"请先恢复持久正式Agent曲面。"
    elif machine_enabled or machine_homed:
        legacy_load_reason = u"加载固定向量前必须禁用机器并处于未Home状态。"
    if legacy_load_reason is not None:
        legacy_load_button.setEnabled(False)
        legacy_load_button.setToolTipText(legacy_load_reason)

    for key in ["legacy_fixed_smoke", "legacy_fixed_validate"]:
        button = self.agent_step_buttons[key]
        reason = None
        if not legacy_fixed_active:
            reason = u"请先加载固定向量临时方案。"
        elif not machine_enabled or not machine_homed:
            reason = u"请启用机器并完成Home。"
        elif values.get("homing-bypass") != "false":
            reason = u"Home过程尚未结束。"
        elif values.get("A-state") != "0" or values.get("B-state") != "0":
            reason = u"请重新Home，使A/B初始状态为0。"
        if reason is not None:
            button.setEnabled(False)
            button.setToolTipText(reason)

    fixed_validation = read_agent_properties(agent_artifact(
        "diagnostics/latest-legacy-fixed-physical-validation.properties"))
    fixed_review = read_agent_properties(agent_artifact(
        "diagnostics/latest-legacy-fixed-physical-review.properties"))
    review_button = self.agent_step_buttons["legacy_fixed_review"]
    if fixed_validation.getProperty("state", "") not in \
            ["passed", "failed-acceptance"]:
        review_button.setEnabled(False)
        review_button.setToolTipText(u"请先完成固定向量视觉验收。")
    compare_button = self.agent_step_buttons["profile_compare"]
    if fixed_review.getProperty("state", "") not in ["passed", "failed"]:
        compare_button.setEnabled(False)
        compare_button.setToolTipText(u"请先完成固定向量结果复核。")
    restore_button = self.agent_step_buttons["legacy_fixed_restore"]
    if not legacy_fixed_active:
        restore_button.setEnabled(False)
        restore_button.setToolTipText(u"当前未运行固定向量临时方案。")
    elif machine_enabled or machine_homed:
        restore_button.setEnabled(False)
        restore_button.setToolTipText(u"恢复正式曲面前必须禁用机器并处于未Home状态。")

    health_button = self.agent_step_buttons["health"]
    health_reason = None
    if not production_active:
        health_reason = u"当前不是已验证的持久正式补偿。"
    elif not machine_enabled or not machine_homed:
        health_reason = u"健康检查需要机器已启用并完成Home。"
    elif values.get("homing-bypass") != "false":
        health_reason = u"Home过程尚未完全结束。"
    elif values.get("A-state") != "0" or values.get("B-state") != "0":
        health_reason = u"请重新Home，使A/B初始状态都为0。"
    if health_reason is not None:
        health_button.setEnabled(False)
        health_button.setToolTipText(health_reason)
    elif health_button.isEnabled():
        health_button.setToolTipText(
            u"使用正式验收网格执行只读式视觉健康检查。")

    confirmation_button = self.agent_step_buttons["health_confirm"]
    confirmation_reason = None
    if not production_active:
        confirmation_reason = u"当前不是已验证的持久正式补偿。"
    elif health.getProperty("automatic-confirmation.performed", "") == "true":
        confirmation_reason = u"最新健康检查已自动完成定向七次复测，无需单独复测。"
    elif health.getProperty("health.result", "") not in ["WARNING", "FAIL"]:
        confirmation_reason = u"只有最近的完整健康检查为WARNING或FAIL时需要复测。"
    elif (health.getProperty("production.promoted-at", "") !=
          formal.getProperty("production.promoted-at", "")):
        confirmation_reason = u"该健康检查不属于当前正式配置版本。"
    elif not machine_enabled or not machine_homed:
        confirmation_reason = u"定向复测需要机器已启用并完成Home。"
    elif values.get("homing-bypass") != "false":
        confirmation_reason = u"Home过程尚未完全结束。"
    elif values.get("A-state") != "0" or values.get("B-state") != "0":
        confirmation_reason = u"请重新Home，使A/B初始状态都为0。"
    if confirmation_reason is not None:
        confirmation_button.setEnabled(False)
        confirmation_button.setToolTipText(confirmation_reason)
    elif confirmation_button.isEnabled():
        confirmation_button.setToolTipText(
            u"对最近WARNING或FAIL的最差速度/距离单元执行7次定向复测。")

    home_load_button = self.agent_step_buttons["home_baseline_load"]
    home_load_reason = None
    if not production_active:
        home_load_reason = u"必须先恢复正在运行的持久正式CoreXY补偿。"
    elif policy.getProperty("home-reference.enabled", "false") != "true":
        home_load_reason = u"请先在目标设置中启用Home复测基准。"
    elif machine_enabled or machine_homed:
        home_load_reason = u"加载未补偿模式前必须禁用机器并处于未Home状态。"
    if home_load_reason is not None:
        home_load_button.setEnabled(False)
        home_load_button.setToolTipText(home_load_reason)
    elif home_load_button.isEnabled():
        home_load_button.setToolTipText(
            u"仅在当前OpenPnP进程关闭CoreXY补偿；正式配置文件保持不变。")

    home_baseline_button = self.agent_step_buttons["home_baseline"]
    home_baseline_reason = None
    if not home_baseline_active:
        home_baseline_reason = u"请先加载Home未补偿基线模式。"
    elif not machine_enabled or not machine_homed:
        home_baseline_reason = u"未补偿基线测量需要机器已启用并完成Home。"
    elif values.get("homing-bypass") != "false":
        home_baseline_reason = u"Home过程尚未完全结束。"
    if home_baseline_reason is not None:
        home_baseline_button.setEnabled(False)
        home_baseline_button.setToolTipText(home_baseline_reason)
    elif home_baseline_button.isEnabled():
        home_baseline_button.setToolTipText(
            u"在CoreXY补偿关闭时测量Home点B+/B-二维差；不写入模型。")

    home_restore_button = self.agent_step_buttons["home_restore"]
    home_restore_reason = None
    if not home_baseline_active:
        home_restore_reason = u"当前没有Home未补偿临时模式需要恢复。"
    elif machine_enabled or machine_homed:
        home_restore_reason = u"恢复正式配置前必须禁用机器并处于未Home状态。"
    if home_restore_reason is not None:
        home_restore_button.setEnabled(False)
        home_restore_button.setToolTipText(home_restore_reason)
    elif home_restore_button.isEnabled():
        home_restore_button.setToolTipText(
            u"结束未补偿诊断模式，重新加载未改动的持久正式配置。")

    home_retest_button = self.agent_step_buttons["home_retest"]
    home_retest_reason = None
    if not production_active:
        home_retest_reason = u"Home复测要求当前运行持久正式CoreXY补偿。"
    elif policy.getProperty("home-reference.enabled", "false") != "true":
        home_retest_reason = u"请先在目标设置中启用Home复测基准。"
    elif not machine_enabled or not machine_homed:
        home_retest_reason = u"Home复测需要机器已启用并完成Home。"
    elif values.get("homing-bypass") != "false":
        home_retest_reason = u"Home过程尚未完全结束。"
    if home_retest_reason is not None:
        home_retest_button.setEnabled(False)
        home_retest_button.setToolTipText(home_retest_reason)
    elif home_retest_button.isEnabled():
        home_retest_button.setToolTipText(
            u"从Home点向工作区内部退让后返回；只隔离B+/B-，不改模型。")

    probe_load_button = self.agent_step_buttons["home_probe_load"]
    probe_load_reason = None
    if not production_active and not home_probe_active:
        probe_load_reason = u"必须先运行正式CoreXY补偿或已加载的Home响应探针。"
    elif not home_baseline_path.isFile():
        probe_load_reason = u"请先完成同一正式版本的Home未补偿基线。"
    elif machine_enabled or machine_homed:
        probe_load_reason = u"加载或切换探针前必须禁用机器并处于未Home状态。"
    if probe_load_reason is not None:
        probe_load_button.setEnabled(False)
        probe_load_button.setToolTipText(probe_load_reason)
    elif probe_load_button.isEnabled():
        probe_load_button.setToolTipText(
            u"选择B-X+、X-、Y+或Y-探针；仅当前进程生效，不改正式配置。")

    for key, label in [
            ("home_probe_x_plus", "x-plus"),
            ("home_probe_x_minus", "x-minus"),
            ("home_probe_y_plus", "y-plus"),
            ("home_probe_y_minus", "y-minus")]:
        button = self.agent_step_buttons[key]
        reason = None
        display = label.replace("-plus", "+").replace("-minus", "-").upper()
        if not home_probe_active or home_probe_label != label:
            reason = u"请先加载B-{}响应探针。".format(display)
        elif not machine_enabled or not machine_homed:
            reason = u"探针测量需要机器已启用并完成Home。"
        elif values.get("homing-bypass") != "false":
            reason = u"Home过程尚未完全结束。"
        if reason is not None:
            button.setEnabled(False)
            button.setToolTipText(reason)
        elif button.isEnabled():
            button.setToolTipText(
                u"执行11次Home B-{}独立响应测量；结束后自动禁用机器。".format(
                    display))

    probe_analysis_button = self.agent_step_buttons["home_probe_analyze"]
    probe_analysis_reason = None
    probe_results = [
        workflow_artifact_path(
            "home_probe_x_plus",
            "diagnostics/latest-home-response-probe-x-plus.properties"),
        workflow_artifact_path(
            "home_probe_x_minus",
            "diagnostics/latest-home-response-probe-x-minus.properties"),
        workflow_artifact_path(
            "home_probe_y_plus",
            "diagnostics/latest-home-response-probe-y-plus.properties"),
        workflow_artifact_path(
            "home_probe_y_minus",
            "diagnostics/latest-home-response-probe-y-minus.properties"),
    ]
    if any([not path.isFile() for path in probe_results]):
        probe_analysis_reason = u"需要先完成B-X+、X-、Y+、Y-四向探针测量。"
    if probe_analysis_reason is not None:
        probe_analysis_button.setEnabled(False)
        probe_analysis_button.setToolTipText(probe_analysis_reason)
    elif probe_analysis_button.isEnabled():
        probe_analysis_button.setToolTipText(
            u"以四向中心差分计算响应矩阵、方向不对称和受安全上限约束的候选。")

    candidate_load_button = self.agent_step_buttons["home_candidate_load"]
    candidate_load_reason = None
    response_analysis_path = agent_artifact(
        "diagnostics/latest-home-response-analysis.properties")
    response_analysis = read_agent_properties(response_analysis_path)
    if (not production_active and not home_probe_active and
            not home_candidate_active):
        candidate_load_reason = u"必须处于正式补偿、Home探针或Home候选运行状态。"
    elif not response_analysis_path.isFile():
        candidate_load_reason = u"请先完成Home二维响应分析。"
    elif response_analysis.getProperty("analysis.method", "") != \
            "centered-four-probe-v1":
