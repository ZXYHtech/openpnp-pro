                "fresh_uncomp_home", "fresh_analyze", "fresh_fit",
                "fresh_restore"]:
        if key in fresh_reasons:
            self.agent_step_buttons[key].setEnabled(False)
            self.agent_step_buttons[key].setToolTipText(fresh_reasons[key])

    primary_home_button = self.agent_step_buttons["primary_home_regression"]
    primary_home_reason = None
    if not production_active:
