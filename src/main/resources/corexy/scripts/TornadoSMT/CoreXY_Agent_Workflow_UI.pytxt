    fresh_session_valid = (fresh_session_path.isFile() and
        fresh_session_dir.isDirectory() and
        fresh_session.getProperty("formal.production-revision", "") ==
        formal.getProperty("production.promoted-at", ""))
    fresh_files = {}
    for name in ["formal-primary", "formal-home-b",
                 "uncompensated-primary", "uncompensated-home-b"]:
        fresh_files[name] = File(fresh_session_dir, name + ".properties")

    fresh_reasons = {}
    if not production_active:
        fresh_reasons["fresh_start"] = u"请先恢复持久正式CoreXY配置。"
    elif machine_enabled or machine_homed:
        fresh_reasons["fresh_start"] = u"新建会话前必须禁用机器并处于未Home状态。"

    if not production_active:
        fresh_reasons["fresh_formal_primary"] = u"当前不是持久正式补偿。"
        fresh_reasons["fresh_formal_home"] = u"当前不是持久正式补偿。"
        fresh_reasons["fresh_uncomp_load"] = u"当前不是持久正式补偿。"
    elif not fresh_session_valid:
        fresh_reasons["fresh_formal_primary"] = u"请先建立新的同期会话。"
        fresh_reasons["fresh_formal_home"] = u"请先建立新的同期会话。"
        fresh_reasons["fresh_uncomp_load"] = u"请先建立新的同期会话。"
    else:
        if not machine_enabled or not machine_homed:
            fresh_reasons["fresh_formal_primary"] = u"请启用机器并完成Home。"
        if not fresh_files["formal-primary"].isFile():
            fresh_reasons["fresh_formal_home"] = u"请先完成同期正式Primary扫描。"
        elif not machine_enabled or not machine_homed:
            fresh_reasons["fresh_formal_home"] = u"请重新启用机器并完成Home。"
        if not fresh_files["formal-home-b"].isFile():
            fresh_reasons["fresh_uncomp_load"] = u"请先完成同期正式Home B扫描。"
        elif machine_enabled or machine_homed:
            fresh_reasons["fresh_uncomp_load"] = u"关闭补偿前必须禁用机器并处于未Home状态。"

    if not home_baseline_active:
        fresh_reasons["fresh_uncomp_primary"] = u"请先加载同期未补偿模式。"
        fresh_reasons["fresh_uncomp_home"] = u"请先加载同期未补偿模式。"
        fresh_reasons["fresh_analyze"] = u"请先完成同期未补偿采样。"
        fresh_reasons["fresh_restore"] = u"当前没有同期未补偿模式需要恢复。"
    else:
        if not machine_enabled or not machine_homed:
            fresh_reasons["fresh_uncomp_primary"] = u"请启用机器并完成Home。"
        if not fresh_files["uncompensated-primary"].isFile():
            fresh_reasons["fresh_uncomp_home"] = u"请先完成同期未补偿Primary扫描。"
        elif not machine_enabled or not machine_homed:
            fresh_reasons["fresh_uncomp_home"] = u"请重新启用机器并完成Home。"
        if not all([path.isFile() for path in fresh_files.values()]):
            fresh_reasons["fresh_analyze"] = u"四组同期扫描尚未全部完成。"
            fresh_reasons["fresh_fit"] = u"四组同期扫描尚未全部完成。"
        elif machine_enabled or machine_homed:
            fresh_reasons["fresh_analyze"] = u"分析前请保持机器禁用。"
            fresh_reasons["fresh_fit"] = u"拟合前请保持机器禁用。"
        if machine_enabled or machine_homed:
            fresh_reasons["fresh_restore"] = u"恢复正式配置前必须禁用机器并处于未Home状态。"

    if not fresh_session_valid or not all(
